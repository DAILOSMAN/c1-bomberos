<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- DayNight: la app sigue el modo claro/oscuro del teléfono, y el WebView
         se entera gracias a setAlgorithmicDarkeningAllowed. -->
    <style name="Tema.C1Bomberos" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/fondo_claro</item>
        <item name="android:statusBarColor">@color/acento</item>
        <item name="android:navigationBarColor">@color/fondo_claro</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>
    </style>
</resources>
